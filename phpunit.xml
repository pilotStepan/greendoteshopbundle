<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <php>
        <!-- MariaDB from `composer test:db`. CI sets its own TEST_DATABASE_URL, which takes precedence. -->
        <env name="TEST_DATABASE_URL" value="mysql://root:root@127.0.0.1:33061/eshop_test?serverVersion=10.5.29-MariaDB&amp;charset=utf8mb4"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Affiliate</directory>
            <directory>tests/Controller</directory>
            <directory>tests/DataLayer</directory>
            <directory>tests/Entity</directory>
            <directory>tests/Export</directory>
            <directory>tests/EventSubscriber</directory>
            <directory>tests/Invoice</directory>
            <directory>tests/Mail</directory>
            <directory>tests/MessageHandler</directory>
            <directory>tests/Messenger</directory>
            <directory>tests/Money</directory>
            <directory>tests/Notification</directory>
            <directory>tests/Parcel</directory>
            <directory>tests/Schema</directory>
            <directory>tests/Service</directory>
            <directory>tests/StateProcessor</directory>
        </testsuite>
        <testsuite name="Functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
