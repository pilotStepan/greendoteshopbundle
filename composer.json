{
  "name": "greendot/eshopbundle",
  "description": "Eshop base for GD eshops",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Greendot",
      "email": "stepan@greendot.cz"
    }
  ],
  "autoload": {
    "psr-4": {
      "Greendot\\EshopBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Greendot\\EshopBundle\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2",
    "algolia/algoliasearch-client-php": "^4.0",
    "symfony/dependency-injection": "^7.0",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/orm": "^3.1",
    "symfony/serializer": "^7.0",
    "api-platform/core": "^4.0",
    "gedmo/doctrine-extensions": "^3.21",
    "symfonycasts/reset-password-bundle": "^1.22",
    "symfony/form": "^7.1",
    "symfony/mailer": "^7.1",
    "symfony/mime": "^7.1",
    "symfony/messenger": "^7.3",
    "symfony/doctrine-messenger": "^7.1",
    "knplabs/knp-paginator-bundle": "^6.5",
    "symfony/security-bundle": "^7.1",
    "symfony/validator": "^7.1",
    "symfony/twig-bundle": "^7.1",
    "symfonycasts/verify-email-bundle": "^1.17",
    "symfony/config": "^7.1",
    "dompdf/dompdf": "^3.1",
    "symfony/workflow": "^7.2",
    "stof/doctrine-extensions-bundle": "^1.13",
    "knpuniversity/oauth2-client-bundle": "^2.18",
    "league/oauth2-facebook": "^2.2",
    "league/oauth2-google": "^4.0",
    "lexik/jwt-authentication-bundle": "^3.1",
    "symfony/http-client": "^7.2",
    "endroid/qr-code": "^6.0",
    "symfony/process": "^7.3",
    "smsbrana/sms-connect": "^0.3.10",
    "alcohol/iso4217": "^4.2",
    "granam/gpwebpay": "^5.1",
    "ext-simplexml": "*",
    "symfony/lock": "^7.3",
    "dragonbe/vies": "^2.3",
    "monolog/monolog": "^3.9",
    "ext-xmlreader": "*",
    "ext-libxml": "*",
    "nzo/url-encryptor-bundle": "^6.4",
    "symfony/translation": "^7.3",
    "karser/karser-recaptcha3-bundle": "^0.3.0",
    "spatie/schema-org": "^4.0",
    "beberlei/doctrineextensions": "^1.5",
    "ext-zip": "*",
    "doctrine/doctrine-migrations-bundle": "^3.7"
  },
  "require-dev": {
    "symfony/http-kernel": "^7.0",
    "symfony/framework-bundle": "^7.1",
    "symfony/browser-kit": "^7.1",
    "phpunit/phpunit": "^10.5",
    "doctrine/doctrine-fixtures-bundle": "^3.6",
    "zenstruck/foundry": "^1.37",
    "symfony/stopwatch": "^7.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "deeplcom/deepl-php": "^1.0"
  },
  "suggest": {
    "deeplcom/deepl-php": "Needed by GenerateTranslation / TranslationController (DEEPL_API_KEY) to machine-translate entities."
  },
  "scripts": {
    "phpstan": [
      "Composer\\Config::disableProcessTimeout",
      "docker compose run --rm --no-deps php vendor/bin/phpstan analyse"
    ],
    "phpstan:baseline": [
      "Composer\\Config::disableProcessTimeout",
      "docker compose run --rm --no-deps php vendor/bin/phpstan analyse --generate-baseline"
    ],
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "docker compose run --rm php vendor/bin/phpunit"
    ],
    "test:db": "docker compose up --detach --wait test-db",
    "test:db:stop": "docker compose down"
  },
  "scripts-descriptions": {
    "phpstan": "Run PHPStan on PHP 8.2 in Docker, as CI does (arguments go to PHPStan)",
    "phpstan:baseline": "Regenerate phpstan-baseline.neon on PHP 8.2 in Docker",
    "test": "Run PHPUnit on PHP 8.2 in Docker, as CI does, starting the test database if it isn't running (arguments go to PHPUnit)",
    "test:db": "Start the MariaDB test database (compose.yaml); does nothing if it is already running",
    "test:db:stop": "Stop and remove the test database"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
